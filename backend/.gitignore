# 1. Dependencies (Never push these, they are massive!)
node_modules/
backend/node_modules/
frontend/node_modules/

# 2. Environment Variables & Local Secrets (CRITICAL for security)
.env
.env.local
.env.production
backend/.env
frontend/.env

# 3. Production Builds
frontend/dist/
frontend/build/
backend/dist/

# 4. IDE / Editor Specific Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 5. OS Generated Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store